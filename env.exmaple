
APPLICATION__HOST=127.0.0.1
APPLICATION__PORT=8080
APPLICATION__ENVIRONMENT=development
APPLICATION__LOG_LEVEL=debug
APPLICATION__JWT_SECRET=change-me-in-production-use-32-plus-chars
APPLICATION__CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE__USERNAME=web-app
DATABASE__PASSWORD=web-app
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__DATABASE_NAME=web-app
DATABASE__REQUIRE_SSL=false
DATABASE__MAX_CONNECTIONS=10

# Optional: cap on concurrent password hashes (default: one per CPU) and how long
# a request waits for a slot before getting 503
# PASSWORD_HASHER__MAX_CONCURRENT=4
# PASSWORD_HASHER__ACQUIRE_TIMEOUT_MS=2000
